# ==============================================================================
# Prompt Like A PRO - LLM Gateway environment
# ==============================================================================
# Copy to `.env` (or export these in your process manager / secret manager) and
# fill in real values. NEVER commit real keys. NEVER put keys in code or logs.
#
# The gateway reads every secret below ONLY from the environment (or a secret
# manager, via gateway.config.set_secret_loader). The game client never sees
# these values - only your backend game servers hold a GATEWAY server token.
# ==============================================================================

# --- Anthropic API key: single key ---------------------------------------------
# One key from your Anthropic organization/workspace. Throughput comes from the
# org rate limit, not the key count. Concurrency is sized to the booth: 6
# laptops = 6 peak simultaneous calls, +2 headroom (GATEWAY_MAX_CONCURRENCY).
ANTHROPIC_ACTIVE_KEY_1=replace-with-your-api-key

# How many keys to read (single-key setup).
GATEWAY_ACTIVE_KEY_COUNT=1
GATEWAY_SPARE_KEY_COUNT=0

# --- Game-server auth ---------------------------------------------------------
# One token per backend game system, as label:token pairs, comma-separated.
# Each game server sends `Authorization: Bearer <token>`. With a single key,
# every server uses active-1.
# Generate strong random tokens, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(32))"
GATEWAY_SERVER_TOKENS=system-1:replace-token-1,system-2:replace-token-2,system-3:replace-token-3,system-4:replace-token-4,system-5:replace-token-5,system-6:replace-token-6

# --- Player-ID hashing (for logs) --------------------------------------------
# Random salt so hashed player IDs in logs can't be reversed. Set a real one.
GATEWAY_HASH_SALT=replace-with-a-long-random-salt

# --- Model / upstream ---------------------------------------------------------
GATEWAY_MODEL=claude-sonnet-5
# thinking: disabled | adaptive | omit  (disabled keeps output bounded & cheap)
GATEWAY_THINKING=disabled
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
GATEWAY_REQUEST_TIMEOUT_SECONDS=30

# --- Key-pool behavior --------------------------------------------------------
GATEWAY_MAX_ATTEMPTS_PER_KEY=3
GATEWAY_KEY_COOLDOWN_SECONDS=60
GATEWAY_BACKOFF_BASE_SECONDS=0.5
GATEWAY_BACKOFF_MAX_SECONDS=8
GATEWAY_RETRY_AFTER_CAP_SECONDS=60

# --- Global (org-wide) concurrency + queue -----------------------------------
# Keep the gateway within the organization's rate limits. Tune concurrency to
# your Anthropic tier; excess requests beyond the queue return "busy".
GATEWAY_MAX_CONCURRENCY=8
GATEWAY_MAX_QUEUE=12

# --- Per-player protections ---------------------------------------------------
GATEWAY_PLAYER_COOLDOWN_SECONDS=5
GATEWAY_MAX_INPUT_TOKENS=2000
GATEWAY_MAX_OUTPUT_TOKENS=1200
GATEWAY_CHARS_PER_TOKEN=4

# --- Cost estimation (per million tokens; Claude Sonnet defaults) -------------
GATEWAY_PRICE_INPUT_PER_MTOK=3.0
GATEWAY_PRICE_OUTPUT_PER_MTOK=15.0

# --- Server bind --------------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100
GATEWAY_LOG_LEVEL=info

